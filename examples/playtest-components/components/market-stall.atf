component "market-stall" {
  bounds 0 0 0 to 6 4 4
  fill 0 0 0 to 6 0 4 minecraft:spruce_planks
  fill 0 1 0 to 0 3 0 minecraft:spruce_fence
  fill 6 1 0 to 6 3 0 minecraft:spruce_fence
  fill 0 1 4 to 0 3 4 minecraft:spruce_fence
  fill 6 1 4 to 6 3 4 minecraft:spruce_fence
  fill 0 4 0 to 6 4 4 minecraft:red_wool
  fill 1 4 0 to 1 4 4 minecraft:white_wool
  fill 3 4 0 to 3 4 4 minecraft:white_wool
  fill 5 4 0 to 5 4 4 minecraft:white_wool
  set 2 1 2 minecraft:barrel[facing=north,open=false]
  set 4 1 2 minecraft:crafting_table
}
