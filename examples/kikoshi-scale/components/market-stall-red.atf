component "market-stall-red" {
  bounds -4 0 -4 to 4 5 4
  fill -3 0 -3 to 3 0 3 minecraft:spruce_planks
  fill -3 1 -3 to -3 3 -3 minecraft:spruce_fence
  fill 3 1 -3 to 3 3 -3 minecraft:spruce_fence
  fill -3 1 3 to -3 3 3 minecraft:spruce_fence
  fill 3 1 3 to 3 3 3 minecraft:spruce_fence
  # striped awning with scalloped front edge
  fill -4 4 -3 to 4 4 -3 minecraft:red_wool
  fill -4 4 -2 to 4 4 -2 minecraft:white_wool
  fill -4 4 -1 to 4 4 -1 minecraft:red_wool
  fill -4 4 0 to 4 4 0 minecraft:white_wool
  fill -4 4 1 to 4 4 1 minecraft:red_wool
  fill -4 4 2 to 4 4 2 minecraft:white_wool
  fill -4 4 3 to 4 4 3 minecraft:red_wool
  set -4 4 -4 minecraft:red_wool
  set -2 4 -4 minecraft:white_wool
  set 0 4 -4 minecraft:red_wool
  set 2 4 -4 minecraft:white_wool
  set 4 4 -4 minecraft:red_wool
  # counter goods: barrels, crates, hanging lantern
  set 0 1 0 minecraft:barrel[facing=up,open=false]
  set -1 1 0 minecraft:barrel[facing=up,open=false]
  set 1 1 0 minecraft:hay_block[axis=y]
  set 0 3 -2 minecraft:lantern[hanging=false,waterlogged=false]
}
