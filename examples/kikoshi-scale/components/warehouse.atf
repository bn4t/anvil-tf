component "warehouse" {
  bounds -10 0 -8 to 10 18 8
  # stone plinth
  fill -9 0 -7 to 9 0 7 minecraft:stone_bricks
  # timber walls: spruce cladding + dark frame posts, front faces -z (water side)
  fill -9 1 -7 to 9 7 -7 minecraft:spruce_planks
  fill -9 1 7 to 9 7 7 minecraft:spruce_planks
  fill -9 1 -7 to -9 7 7 minecraft:spruce_planks
  fill 9 1 -7 to 9 7 7 minecraft:spruce_planks
  fill -9 1 -7 to -9 7 -7 minecraft:dark_oak_log
  fill 9 1 -7 to 9 7 -7 minecraft:dark_oak_log
  fill -9 1 7 to -9 7 7 minecraft:dark_oak_log
  fill 9 1 7 to 9 7 7 minecraft:dark_oak_log
  fill -9 7 -7 to 9 7 -7 minecraft:dark_oak_log
  fill -9 7 7 to 9 7 7 minecraft:dark_oak_log
  fill -4 1 -7 to -4 7 -7 minecraft:dark_oak_log
  fill 4 1 -7 to 4 7 -7 minecraft:dark_oak_log
  # loading doors + hayloft hatch
  fill -1 1 -7 to 1 3 -7 minecraft:dark_oak_planks
  set -1 1 -7 minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set -1 2 -7 minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  set 1 1 -7 minecraft:spruce_door[facing=north,half=lower,hinge=right,open=false,powered=false]
  set 1 2 -7 minecraft:spruce_door[facing=north,half=upper,hinge=right,open=false,powered=false]
  fill -1 4 -7 to 1 5 -7 minecraft:spruce_trapdoor[facing=north,half=bottom,open=false,waterlogged=false]
  # small square windows
  fill -7 4 -7 to -6 5 -7 minecraft:air
  fill -7 4 -6 to -6 5 -6 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 6 4 -7 to 7 5 -7 minecraft:air
  fill 6 4 -6 to 7 5 -6 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -7 4 7 to -6 5 7 minecraft:air
  fill -7 4 6 to -6 5 6 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # merchant pennants hanging on the water-side facade
  set -3 4 -8 minecraft:blue_wall_banner[facing=north]
  set 3 4 -8 minecraft:blue_wall_banner[facing=north]
  set -3 5 -8 minecraft:blue_wall_banner[facing=north]
  set 3 5 -8 minecraft:blue_wall_banner[facing=north]
  # hoist jib: beam out over the door side + hanging chain with crate hook
  fill -1 8 -7 to -1 8 -9 minecraft:dark_oak_log
  set -1 8 -9 minecraft:spruce_trapdoor[facing=north,half=bottom,open=true,waterlogged=false]
  fill -1 5 -9 to -1 7 -9 minecraft:iron_chain[axis=y,waterlogged=false]
  set -1 4 -9 minecraft:barrel[facing=up,open=false]
  # interior: open hall with storage floor
  fill -8 1 -6 to 8 6 6 minecraft:air
  fill -8 0 -6 to 8 0 6 minecraft:spruce_planks
  fill -7 1 3 to -5 1 5 minecraft:oak_planks
  set -8 1 -3 minecraft:hay_block[axis=y]
  set -7 1 -3 minecraft:hay_block[axis=y]
  set 6 1 4 minecraft:barrel[facing=up,open=false]
  set 7 1 4 minecraft:barrel[facing=up,open=false]
  set 7 2 4 minecraft:hay_block[axis=y]
  fill -6 1 -4 to -4 1 -4 minecraft:spruce_stairs[facing=south,half=bottom,waterlogged=false]
  set -3 6 0 minecraft:lantern[hanging=true,waterlogged=false]
  set 3 6 0 minecraft:lantern[hanging=true,waterlogged=false]
  # west-wall shelving: low boards + fenced uprights + high shelf row
  fill -8 1 -4 to -8 1 4 minecraft:spruce_planks
  set -8 2 -4 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  set -8 2 4 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  fill -8 3 -4 to -8 3 4 minecraft:oak_planks
  set -8 4 -2 minecraft:barrel[facing=up,open=false]
  set -8 4 1 minecraft:chest[facing=east,type=single,waterlogged=false]
  # catwalk on posts along the north wall, ladder up through the deck gap
  fill -8 1 -6 to -8 4 -6 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  fill 0 1 -6 to 0 4 -6 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  fill 8 1 -6 to 8 4 -6 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  fill -8 5 -6 to 4 5 -6 minecraft:dark_oak_planks
  fill 6 5 -6 to 8 5 -6 minecraft:dark_oak_planks
  fill 5 1 -6 to 5 5 -6 minecraft:ladder[facing=south,waterlogged=false]
  fill -8 6 -6 to -7 6 -6 minecraft:spruce_planks
  set 7 6 -6 minecraft:barrel[facing=up,open=false]
  # gambrel roof: ridge along x, two-step slope, gable ends
  fill -9 8 -9 to 9 8 9 minecraft:dark_prismarine
  fill -9 9 -7 to 9 9 7 minecraft:dark_prismarine
  fill -9 10 -4 to 9 10 4 minecraft:dark_prismarine
  fill -9 11 -2 to 9 11 2 minecraft:dark_prismarine
  fill -9 12 0 to 9 12 0 minecraft:prismarine_bricks
  fill -9 8 -7 to -9 8 7 minecraft:dark_oak_planks
  fill -9 9 -5 to -9 9 5 minecraft:dark_oak_planks
  fill -9 10 -2 to -9 10 2 minecraft:dark_oak_planks
  fill -9 11 0 to -9 11 0 minecraft:dark_oak_planks
  fill 9 8 -7 to 9 8 7 minecraft:dark_oak_planks
  fill 9 9 -5 to 9 9 5 minecraft:dark_oak_planks
  fill 9 10 -2 to 9 10 2 minecraft:dark_oak_planks
  fill 9 11 0 to 9 11 0 minecraft:dark_oak_planks
  # ridge caps + eave lanterns at the jib end
  fill -9 12 0 to 9 12 0 minecraft:dark_oak_slab[type=top,waterlogged=false]
  set -2 13 0 minecraft:spruce_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  set 2 13 0 minecraft:spruce_fence[east=false,north=false,south=false,waterlogged=false,west=false]
}
