component "quay-chain" {
  bounds -6 0 -1 to 6 3 1
  # chain swag strung between quay piles, sagging at the middle
  fill -6 2 0 to -3 2 0 minecraft:iron_chain[axis=x,waterlogged=false]
  fill 3 2 0 to 6 2 0 minecraft:iron_chain[axis=x,waterlogged=false]
  fill -2 1 0 to 2 1 0 minecraft:iron_chain[axis=x,waterlogged=false]
  set -3 2 0 minecraft:iron_chain[axis=x,waterlogged=false]
  set 3 2 0 minecraft:iron_chain[axis=x,waterlogged=false]
}
