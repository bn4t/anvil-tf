component "marker-tower" {
  bounds -1 0 -1 to 5 14 5
  fill 0 0 0 to 4 0 4 minecraft:mossy_stone_bricks
  fill 1 0 1 to 3 1 3 minecraft:stone_bricks
  fill 2 1 2 to 2 7 2 minecraft:stripped_spruce_log[axis=y]
  # cross-braced mid band
  fill 1 4 1 to 1 7 1 minecraft:spruce_log
  fill 3 4 1 to 3 7 1 minecraft:spruce_log
  fill 1 4 3 to 1 7 3 minecraft:spruce_log
  fill 3 4 3 to 3 7 3 minecraft:spruce_log
  fill 1 8 1 to 3 8 3 minecraft:dark_oak_planks
  # lookout platform with cut corners + fence rail
  fill 0 9 0 to 4 9 4 minecraft:dark_oak_planks
  set 0 9 0 minecraft:air
  set 4 9 0 minecraft:air
  set 0 9 4 minecraft:air
  set 4 9 4 minecraft:air
  fill 0 10 1 to 0 10 3 minecraft:spruce_fence
  fill 4 10 1 to 4 10 3 minecraft:spruce_fence
  fill 1 10 0 to 3 10 0 minecraft:spruce_fence
  fill 1 10 4 to 3 10 4 minecraft:spruce_fence
  # capped roof + lantern + pennant
  fill 1 11 1 to 3 11 3 minecraft:dark_prismarine
  fill 2 12 2 to 2 12 2 minecraft:dark_prismarine
  set 2 10 2 minecraft:lantern[hanging=false,waterlogged=false]
  fill 2 13 2 to 2 13 2 minecraft:spruce_fence
  set 3 13 2 minecraft:green_wool
}
