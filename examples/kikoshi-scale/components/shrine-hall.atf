component "shrine-hall" {
  bounds -7 0 -7 to 7 22 7
  # stone platform + steps (front -z)
  fill -6 0 -6 to 6 0 6 minecraft:stone_bricks
  fill -5 1 -6 to 5 1 6 minecraft:polished_andesite
  fill -2 0 -7 to 2 0 -7 minecraft:stone_brick_stairs[facing=north,half=bottom,waterlogged=false]
  # tier 1 walls: dark posts + white panels + red trim
  fill -5 2 -5 to 5 7 -5 minecraft:white_wool
  fill -5 2 5 to 5 7 5 minecraft:white_wool
  fill -5 2 -5 to -5 7 5 minecraft:white_wool
  fill 5 2 -5 to 5 7 5 minecraft:white_wool
  fill -5 2 -5 to -5 7 -5 minecraft:dark_oak_log
  fill 5 2 -5 to 5 7 -5 minecraft:dark_oak_log
  fill -5 2 5 to -5 7 5 minecraft:dark_oak_log
  fill 5 2 5 to 5 7 5 minecraft:dark_oak_log
  fill -5 7 -5 to 5 7 -5 minecraft:red_wool
  fill -5 7 5 to 5 7 5 minecraft:red_wool
  fill -5 7 -5 to -5 7 5 minecraft:red_wool
  fill 5 7 -5 to 5 7 5 minecraft:red_wool
  # door + narrow windows
  set -1 2 -5 minecraft:oak_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set -1 3 -5 minecraft:oak_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  set 1 2 -5 minecraft:oak_door[facing=north,half=lower,hinge=right,open=false,powered=false]
  set 1 3 -5 minecraft:oak_door[facing=north,half=upper,hinge=right,open=false,powered=false]
  fill -3 3 -5 to -3 5 -5 minecraft:air
  fill -3 2 -4 to -3 2 -4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  set -3 3 -4 minecraft:glass_pane[east=false,north=false,south=false,waterlogged=false,west=false]
  fill 3 3 -5 to 3 5 -5 minecraft:air
  fill 3 2 -4 to 3 2 -4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  set 3 3 -4 minecraft:glass_pane[east=false,north=false,south=false,waterlogged=false,west=false]
  # interior: open prayer hall
  fill -4 2 -3 to 4 6 3 minecraft:air
  fill -4 1 -4 to 4 1 4 minecraft:dark_oak_planks
  fill -3 2 3 to -1 2 4 minecraft:spruce_stairs[facing=north,half=bottom,waterlogged=false]
  fill 1 2 3 to 3 2 4 minecraft:spruce_stairs[facing=north,half=bottom,waterlogged=false]
  set 0 2 4 minecraft:hay_block[axis=y]
  set -3 5 0 minecraft:lantern[hanging=true,waterlogged=false]
  set 3 5 0 minecraft:lantern[hanging=true,waterlogged=false]
  # tier 1 eave: wide slab skirt with upturned corners + hanging lanterns
  fill -7 8 -7 to 7 8 7 minecraft:dark_prismarine_slab[type=top,waterlogged=false]
  fill -6 9 -6 to 6 9 6 minecraft:dark_prismarine_slab[type=bottom,waterlogged=false]
  set -6 7 -6 minecraft:lantern[hanging=false,waterlogged=false]
  set 6 7 -6 minecraft:lantern[hanging=false,waterlogged=false]
  set -6 7 6 minecraft:lantern[hanging=false,waterlogged=false]
  set 6 7 6 minecraft:lantern[hanging=false,waterlogged=false]
  # tier 2: inset walls
  fill -4 9 -4 to 4 13 -4 minecraft:red_wool
  fill -4 9 4 to 4 13 4 minecraft:red_wool
  fill -4 9 -4 to -4 13 4 minecraft:red_wool
  fill 4 9 -4 to 4 13 4 minecraft:red_wool
  fill -4 9 -4 to -4 13 -4 minecraft:dark_oak_log
  fill 4 9 -4 to 4 13 -4 minecraft:dark_oak_log
  fill -4 9 4 to -4 13 4 minecraft:dark_oak_log
  fill 4 9 4 to 4 13 4 minecraft:dark_oak_log
  fill -2 10 -4 to -1 12 -4 minecraft:air
  fill -2 9 -3 to -1 9 -3 minecraft:spruce_slab[type=bottom,waterlogged=false]
  set -2 10 -3 minecraft:glass_pane[east=false,north=false,south=false,waterlogged=false,west=false]
  fill 1 10 -4 to 2 12 -4 minecraft:air
  fill 1 9 -3 to 2 9 -3 minecraft:spruce_slab[type=bottom,waterlogged=false]
  set 1 10 -3 minecraft:glass_pane[east=false,north=false,south=false,waterlogged=false,west=false]
  fill -3 9 -2 to 3 12 2 minecraft:air
  set 0 12 0 minecraft:lantern[hanging=true,waterlogged=false]
  # tier 2 eave
  fill -6 14 -6 to 6 14 6 minecraft:dark_prismarine_slab[type=top,waterlogged=false]
  fill -5 15 -5 to 5 15 5 minecraft:dark_prismarine_slab[type=bottom,waterlogged=false]
  set -5 13 -5 minecraft:lantern[hanging=false,waterlogged=false]
  set 5 13 -5 minecraft:lantern[hanging=false,waterlogged=false]
  set -5 13 5 minecraft:lantern[hanging=false,waterlogged=false]
  set 5 13 5 minecraft:lantern[hanging=false,waterlogged=false]
  # crown: small inner room + tall cap roof
  fill -3 15 -3 to 3 18 -3 minecraft:white_wool
  fill -3 15 3 to 3 18 3 minecraft:white_wool
  fill -3 15 -3 to -3 18 3 minecraft:white_wool
  fill 3 15 -3 to 3 18 3 minecraft:white_wool
  fill -3 18 -3 to 3 18 3 minecraft:dark_oak_planks
  fill -2 19 -2 to 2 19 2 minecraft:dark_prismarine
  fill -3 20 -3 to 3 20 3 minecraft:dark_prismarine
  fill -2 21 -2 to 2 21 2 minecraft:dark_prismarine
  fill 0 20 -1 to 0 20 1 minecraft:prismarine_bricks
  set 0 22 0 minecraft:spruce_fence[east=false,north=false,south=false,waterlogged=false,west=false]
}
