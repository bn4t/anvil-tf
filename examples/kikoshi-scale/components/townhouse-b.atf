component "townhouse-b" {
  bounds -6 0 -6 to 6 19 6
  fill -4 0 -4 to 4 0 4 minecraft:stone_bricks
  # narrow three-story town house: stone ground, jettied timber upper floors
  fill -4 1 -4 to 4 5 -4 minecraft:mossy_stone_bricks
  fill -4 1 4 to 4 5 4 minecraft:mossy_stone_bricks
  fill -4 1 -4 to -4 5 4 minecraft:mossy_stone_bricks
  fill 4 1 -4 to 4 5 4 minecraft:mossy_stone_bricks
  # corbel band under the jetty overhang
  fill -5 5 -4 to -5 5 4 minecraft:spruce_log
  fill 5 5 -4 to 5 5 4 minecraft:spruce_log
  fill -4 5 -5 to 4 5 -5 minecraft:spruce_log
  fill -4 5 5 to 4 5 5 minecraft:spruce_log
  # second floor overhangs one block
  fill -5 6 -5 to 5 9 -5 minecraft:spruce_planks
  fill -5 6 5 to 5 9 5 minecraft:spruce_planks
  fill -5 6 -5 to -5 9 5 minecraft:spruce_planks
  fill 5 6 -5 to 5 9 5 minecraft:spruce_planks
  # third floor
  fill -5 10 -5 to 5 13 -5 minecraft:mossy_stone_bricks
  fill -5 10 5 to 5 13 5 minecraft:mossy_stone_bricks
  fill -5 10 -5 to -5 13 5 minecraft:mossy_stone_bricks
  fill 5 10 -5 to 5 13 5 minecraft:mossy_stone_bricks
  # timber studs
  fill -5 6 -5 to -5 9 -5 minecraft:dark_oak_log
  fill 5 6 -5 to 5 9 -5 minecraft:dark_oak_log
  fill -5 6 5 to -5 9 5 minecraft:dark_oak_log
  fill 5 6 5 to 5 9 5 minecraft:dark_oak_log
  fill -1 6 -5 to -1 9 -5 minecraft:dark_oak_log
  fill 1 6 5 to 1 9 5 minecraft:dark_oak_log
  # floor slabs between stories
  fill -4 5 -4 to 4 5 4 minecraft:dark_oak_planks
  fill -5 9 -5 to 5 9 5 minecraft:dark_oak_planks
  # recessed windows + shutters (glass set one block deep)
  fill -2 3 -4 to 0 4 -4 minecraft:air
  fill -2 3 -3 to 0 4 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 2 -3 to 0 2 -3 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill 1 3 -4 to 3 4 -4 minecraft:air
  fill 1 3 -3 to 3 4 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 2 -3 to 3 2 -3 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill -2 7 -5 to 0 8 -5 minecraft:air
  fill -2 7 -4 to 0 8 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 6 -4 to 0 6 -4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill 1 7 -5 to 3 8 -5 minecraft:air
  fill 1 7 -4 to 3 8 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 6 -4 to 3 6 -4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill -2 11 -5 to 0 12 -5 minecraft:air
  fill -2 11 -4 to 0 12 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 10 -4 to 0 10 -4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill 1 11 -5 to 3 12 -5 minecraft:air
  fill 1 11 -4 to 3 12 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 10 -4 to 3 10 -4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill -2 11 5 to 0 12 5 minecraft:air
  fill -2 11 4 to 0 12 4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 10 4 to 0 10 4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill 1 11 5 to 3 12 5 minecraft:air
  fill 1 11 4 to 3 12 4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 10 4 to 3 10 4 minecraft:spruce_slab[type=bottom,waterlogged=false]
  set -3 7 -6 minecraft:spruce_trapdoor[facing=north,half=bottom,open=false,waterlogged=false]
  set 0 7 -6 minecraft:spruce_trapdoor[facing=north,half=bottom,open=false,waterlogged=false]
  # flower boxes under the second- and third-floor windows on the street face
  fill -2 6 -6 to 0 6 -6 minecraft:spruce_slab[type=top,waterlogged=false]
  fill 1 6 -6 to 3 6 -6 minecraft:spruce_slab[type=top,waterlogged=false]
  fill -2 7 -6 to 0 7 -6 minecraft:azalea_leaves[persistent=true,waterlogged=false]
  fill 1 7 -6 to 3 7 -6 minecraft:flowering_azalea_leaves[persistent=true,waterlogged=false]
  fill -2 10 -6 to 0 10 -6 minecraft:spruce_slab[type=top,waterlogged=false]
  fill 1 10 -6 to 3 10 -6 minecraft:spruce_slab[type=top,waterlogged=false]
  fill -2 11 -6 to 0 11 -6 minecraft:flowering_azalea_leaves[persistent=true,waterlogged=false]
  fill 1 11 -6 to 3 11 -6 minecraft:azalea_leaves[persistent=true,waterlogged=false]
  set 0 1 -4 minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set 0 2 -4 minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  set -1 1 -4 minecraft:dark_oak_log
  set 1 1 -4 minecraft:dark_oak_log
  # weathering: vines climbing the east wall
  fill 5 2 1 to 5 3 3 minecraft:vine[down=false,east=false,north=false,south=false,up=false,waterlogged=false,west=true]
  set 5 1 2 minecraft:vine[down=false,east=false,north=false,south=false,up=false,waterlogged=false,west=true]
  set 5 4 2 minecraft:vine[down=false,east=false,north=false,south=false,up=false,waterlogged=false,west=true]
  # furnished interior: entry room + two upper rooms, all lit
  fill -3 2 -3 to 3 4 3 minecraft:air
  fill -4 6 -3 to 4 8 3 minecraft:air
  fill -4 10 -3 to 4 12 3 minecraft:air
  fill -3 1 -3 to 3 1 3 minecraft:spruce_planks
  fill -3 2 -2 to -3 3 2 minecraft:bookshelf
  set -2 2 3 minecraft:barrel[facing=up,open=false]
  fill 1 2 2 to 2 2 3 minecraft:spruce_stairs[facing=north,half=bottom,waterlogged=false]
  # ladders linking all three floors (holes cut through both decks)
  fill 3 2 0 to 3 5 0 minecraft:ladder[facing=west,waterlogged=false]
  fill 4 6 -2 to 4 9 -2 minecraft:ladder[facing=west,waterlogged=false]
  set 0 4 0 minecraft:lantern[hanging=true,waterlogged=false]
  fill -4 6 -2 to -4 7 2 minecraft:bookshelf
  set 3 6 -2 minecraft:hay_block[axis=y]
  set 0 8 0 minecraft:lantern[hanging=true,waterlogged=false]
  set -3 10 3 minecraft:barrel[facing=up,open=false]
  set 0 12 0 minecraft:lantern[hanging=true,waterlogged=false]
  # gabled roof: ridge along z, eave overhang on x
  fill -6 14 -5 to 6 14 5 minecraft:dark_prismarine
  fill -4 15 -5 to 4 15 5 minecraft:dark_prismarine
  fill -2 16 -5 to 2 16 5 minecraft:dark_prismarine
  fill 0 17 -5 to 0 17 5 minecraft:prismarine_bricks
  # gable end walls
  fill -4 14 -5 to 4 14 -5 minecraft:spruce_planks
  fill -3 15 -5 to 3 15 -5 minecraft:spruce_planks
  fill -1 16 -5 to 1 16 -5 minecraft:spruce_planks
  fill -4 14 5 to 4 14 5 minecraft:spruce_planks
  fill -3 15 5 to 3 15 5 minecraft:spruce_planks
  fill -1 16 5 to 1 16 5 minecraft:spruce_planks
  fill 2 14 -2 to 2 16 -2 minecraft:cobblestone
  set 2 17 -2 minecraft:cobblestone_wall[east=false,north=false,south=false,waterlogged=false,west=false]
  set 0 18 0 minecraft:lantern[hanging=false,waterlogged=false]
}
