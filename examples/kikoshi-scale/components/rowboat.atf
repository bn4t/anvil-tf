component "rowboat" {
  bounds -3 0 -3 to 3 1 3
  # small moored rowboat; place with y at water surface
  fill -2 0 -2 to 2 0 2 minecraft:spruce_planks
  fill -3 1 -2 to -3 1 2 minecraft:dark_oak_planks
  fill 3 1 -2 to 3 1 2 minecraft:dark_oak_planks
  fill -2 1 -3 to 2 1 -3 minecraft:dark_oak_planks
  fill -2 1 3 to 2 1 3 minecraft:dark_oak_planks
  set -1 1 -1 minecraft:spruce_stairs[facing=west,half=bottom,waterlogged=false]
  set 1 1 1 minecraft:spruce_stairs[facing=east,half=bottom,waterlogged=false]
  set 0 0 0 minecraft:oak_planks
}
