component "townhouse-d" {
  bounds -6 0 -6 to 6 21 6
  # stone foundation + brick ground floor
  fill -5 0 -4 to 5 0 4 minecraft:stone_bricks
  fill -5 1 -4 to 5 5 -4 minecraft:bricks
  fill -5 1 4 to 5 5 4 minecraft:bricks
  fill -5 1 -4 to -5 5 4 minecraft:bricks
  fill 5 1 -4 to 5 5 4 minecraft:bricks
  # granite quoins and string course
  fill -5 1 -4 to -5 5 -4 minecraft:polished_granite
  fill 5 1 -4 to 5 5 -4 minecraft:polished_granite
  fill -5 1 4 to -5 5 4 minecraft:polished_granite
  fill 5 1 4 to 5 5 4 minecraft:polished_granite
  fill -5 5 -4 to 5 5 -4 minecraft:polished_granite
  fill -5 5 4 to 5 5 4 minecraft:polished_granite
  fill -5 5 -3 to -5 5 3 minecraft:polished_granite
  fill 5 5 -3 to 5 5 3 minecraft:polished_granite
  # second floor: brick with timber studs
  fill -5 6 -4 to 5 9 -4 minecraft:bricks
  fill -5 6 4 to 5 9 4 minecraft:bricks
  fill -5 6 -4 to -5 9 4 minecraft:bricks
  fill 5 6 -4 to 5 9 4 minecraft:bricks
  fill -5 6 -4 to -5 9 -4 minecraft:dark_oak_log
  fill 5 6 -4 to 5 9 -4 minecraft:dark_oak_log
  fill -5 6 4 to -5 9 4 minecraft:dark_oak_log
  fill 5 6 4 to 5 9 4 minecraft:dark_oak_log
  fill -5 9 -4 to 5 9 -4 minecraft:dark_oak_log
  fill -5 9 4 to 5 9 4 minecraft:dark_oak_log
  fill -5 10 -4 to 5 10 -4 minecraft:polished_granite
  fill -5 10 4 to 5 10 4 minecraft:polished_granite
  fill -5 10 -3 to -5 10 3 minecraft:polished_granite
  fill 5 10 -3 to 5 10 3 minecraft:polished_granite
  # third floor: spruce panels between brick piers
  fill -5 11 -4 to 5 13 -4 minecraft:spruce_planks
  fill -5 11 4 to 5 13 4 minecraft:spruce_planks
  fill -5 11 -4 to -5 13 4 minecraft:spruce_planks
  fill 5 11 -4 to 5 13 4 minecraft:spruce_planks
  fill -5 11 -4 to -5 13 -4 minecraft:bricks
  fill 5 11 -4 to 5 13 -4 minecraft:bricks
  fill -5 11 4 to -5 13 4 minecraft:bricks
  fill 5 11 4 to 5 13 4 minecraft:bricks
  fill 0 11 -4 to 0 13 -4 minecraft:bricks
  # recessed windows with granite sills
  fill -3 2 -4 to -2 3 -4 minecraft:air
  fill -3 2 -3 to -2 3 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 2 -4 to 3 3 -4 minecraft:air
  fill 2 2 -3 to 3 3 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -3 1 -4 to -2 1 -4 minecraft:polished_granite
  fill 2 1 -4 to 3 1 -4 minecraft:polished_granite
  fill -3 7 -4 to -2 8 -4 minecraft:air
  fill -3 7 -3 to -2 8 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 7 -4 to 3 8 -4 minecraft:air
  fill 2 7 -3 to 3 8 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 12 -4 to -1 13 -4 minecraft:air
  fill -2 12 -3 to -1 13 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 12 -4 to 2 13 -4 minecraft:air
  fill 1 12 -3 to 2 13 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # rear windows on the upper floors
  fill -3 7 4 to -2 8 4 minecraft:air
  fill -3 7 3 to -2 8 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 7 4 to 3 8 4 minecraft:air
  fill 2 7 3 to 3 8 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # street door + flat trapdoor awning with lantern
  set 0 1 -4 minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set 0 2 -4 minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  fill -2 4 -5 to 2 4 -5 minecraft:dark_oak_slab[type=bottom,waterlogged=false]
  set 0 3 -5 minecraft:lantern[hanging=false,waterlogged=false]
  # furnished floors: parlor, study, loft — all lit
  fill -4 1 -3 to 4 1 3 minecraft:dark_oak_planks
  fill -4 2 -3 to 4 4 3 minecraft:air
  fill -4 5 -3 to 4 5 3 minecraft:dark_oak_planks
  fill -4 6 -3 to 4 8 3 minecraft:air
  fill -4 10 -3 to 4 10 3 minecraft:dark_oak_planks
  fill -4 11 -3 to 4 13 3 minecraft:air
  fill -4 2 -3 to -4 3 3 minecraft:bookshelf
  set 3 2 2 minecraft:barrel[facing=up,open=false]
  fill -1 2 2 to 1 2 3 minecraft:spruce_stairs[facing=north,half=bottom,waterlogged=false]
  set 0 4 0 minecraft:lantern[hanging=true,waterlogged=false]
  set 2 2 -2 minecraft:campfire[facing=north,lit=true,signal_fire=false,waterlogged=false]
  fill -4 6 -2 to -4 7 2 minecraft:bookshelf
  set 3 6 -2 minecraft:hay_block[axis=y]
  set 0 8 0 minecraft:lantern[hanging=true,waterlogged=false]
  set -3 11 2 minecraft:chest[facing=south,waterlogged=false]
  set 0 13 0 minecraft:lantern[hanging=true,waterlogged=false]
  # ladders linking all floors (holes cut through the decks)
  fill -4 2 0 to -4 5 0 minecraft:ladder[facing=east,waterlogged=false]
  fill -4 6 0 to -4 10 0 minecraft:ladder[facing=east,waterlogged=false]
  fill -4 11 0 to -4 13 0 minecraft:ladder[facing=east,waterlogged=false]
  # oxidized copper roof: stepped gable ridge along x, weathervane finials
  fill -6 14 -6 to 6 14 6 minecraft:oxidized_copper
  fill -6 15 -4 to 6 15 4 minecraft:oxidized_copper
  fill -6 16 -2 to 6 16 2 minecraft:weathered_copper
  fill -6 17 0 to 6 17 0 minecraft:weathered_copper
  fill -6 18 -1 to 6 18 1 minecraft:oxidized_cut_copper
  set -5 19 0 minecraft:lightning_rod[facing=up,powered=false,waterlogged=false]
  set 5 19 0 minecraft:lightning_rod[facing=up,powered=false,waterlogged=false]
  # gable end fills + brick chimney
  fill -4 14 -5 to 4 14 -5 minecraft:bricks
  fill -2 15 -5 to 2 15 -5 minecraft:bricks
  fill 0 16 -5 to 0 16 -5 minecraft:bricks
  fill -4 14 5 to 4 14 5 minecraft:bricks
  fill -2 15 5 to 2 15 5 minecraft:bricks
  fill 0 16 5 to 0 16 5 minecraft:bricks
  fill 2 14 -1 to 2 19 -1 minecraft:bricks
  set 2 20 -1 minecraft:brick_wall[east=false,north=false,south=false,waterlogged=false,west=false]
  set 0 19 0 minecraft:lantern[hanging=false,waterlogged=false]
}
