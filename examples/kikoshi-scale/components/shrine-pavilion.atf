component "shrine-pavilion" {
  bounds -5 0 -5 to 5 12 5
  # four-post pavilion: raised deck, corner columns, two stepped roof tiers
  fill -4 0 -4 to 4 0 4 minecraft:stone_bricks
  fill -3 1 -3 to 3 1 3 minecraft:spruce_planks
  fill -4 1 -4 to -4 7 -4 minecraft:dark_oak_log
  fill 4 1 -4 to 4 7 -4 minecraft:dark_oak_log
  fill -4 1 4 to -4 7 4 minecraft:dark_oak_log
  fill 4 1 4 to 4 7 4 minecraft:dark_oak_log
  # low roof tier with upturned eave corners
  fill -5 8 -5 to 5 8 5 minecraft:dark_prismarine
  set -5 8 -5 minecraft:air
  set 5 8 -5 minecraft:air
  set -5 8 5 minecraft:air
  set 5 8 5 minecraft:air
  fill -5 9 -5 to -5 9 -5 minecraft:dark_prismarine
  fill 5 9 -5 to 5 9 -5 minecraft:dark_prismarine
  fill -5 9 5 to -5 9 5 minecraft:dark_prismarine
  fill 5 9 5 to 5 9 5 minecraft:dark_prismarine
  # upper roof tier
  fill -3 9 -3 to 3 9 3 minecraft:dark_prismarine
  fill -2 10 -2 to 2 10 2 minecraft:dark_prismarine
  set 0 11 0 minecraft:sea_lantern
  # lantern accents under the eaves
  set -4 7 -4 minecraft:lantern[hanging=false,waterlogged=false]
  set 4 7 -4 minecraft:lantern[hanging=false,waterlogged=false]
  set -4 7 4 minecraft:lantern[hanging=false,waterlogged=false]
  set 4 7 4 minecraft:lantern[hanging=false,waterlogged=false]
}
