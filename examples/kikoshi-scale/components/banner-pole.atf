component "banner-pole" {
  bounds -1 0 -1 to 1 5 1
  # standing standard: fence pole, crossbar finial, banner cloth
  fill 0 0 0 to 0 3 0 minecraft:dark_oak_log
  fill -1 3 0 to 1 3 0 minecraft:spruce_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  # banner cloth hangs off the pole's east face under the crossbar
  set 1 2 0 minecraft:red_wall_banner[facing=east]
}
