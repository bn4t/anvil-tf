component "spruce-tree" {
  bounds -2 0 -2 to 2 11 2
  fill 0 0 0 to 0 8 0 minecraft:spruce_log[axis=y]
  fill -2 3 -2 to 2 3 2 minecraft:spruce_leaves[distance=1,persistent=true,waterlogged=false]
  fill -1 4 -1 to 1 4 1 minecraft:spruce_leaves[distance=1,persistent=true,waterlogged=false]
  fill -2 5 -2 to 2 6 2 minecraft:spruce_leaves[distance=1,persistent=true,waterlogged=false]
  set 0 5 0 minecraft:spruce_log[axis=y]
  fill -1 7 -1 to 1 7 1 minecraft:spruce_leaves[distance=1,persistent=true,waterlogged=false]
  fill -1 8 -1 to 1 8 1 minecraft:spruce_leaves[distance=1,persistent=true,waterlogged=false]
  set 0 9 0 minecraft:spruce_leaves[distance=1,persistent=true,waterlogged=false]
  set 0 10 0 minecraft:spruce_leaves[distance=1,persistent=true,waterlogged=false]
}
