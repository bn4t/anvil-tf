component "fish-rack" {
  bounds -3 0 -2 to 3 4 2
  # drying rack: two posts, chain crossbar, hanging net + rope coil
  set -2 0 0 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  set -2 1 0 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  set -2 2 0 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  set 2 0 0 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  set 2 1 0 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  set 2 2 0 minecraft:dark_oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  fill -1 2 0 to 1 2 0 minecraft:iron_chain[axis=x,waterlogged=false]
  fill -1 1 0 to 1 1 0 minecraft:cobweb
  # coiled rope + catch
  set 0 0 1 minecraft:hay_block[axis=y]
  set -1 0 1 minecraft:barrel[facing=up,open=false]
  set 3 0 -1 minecraft:spruce_slab[type=bottom,waterlogged=false]
  set 3 1 -1 minecraft:cobweb
}
