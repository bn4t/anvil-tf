component "festoon" {
  bounds -4 0 -1 to 4 5 1
  # chain swag strung between two lantern posts 8 apart, lantern mid-span
  fill -3 4 0 to -2 4 0 minecraft:iron_chain[axis=x,waterlogged=false]
  fill 2 4 0 to 3 4 0 minecraft:iron_chain[axis=x,waterlogged=false]
  set -1 3 0 minecraft:iron_chain[axis=x,waterlogged=false]
  set 1 3 0 minecraft:iron_chain[axis=x,waterlogged=false]
  set 0 3 0 minecraft:iron_chain[axis=x,waterlogged=false]
  set 0 2 0 minecraft:lantern[hanging=true,waterlogged=false]
}
