component "signpost" {
  bounds -1 0 -1 to 1 5 1
  # post with a lantern cap and finger signs on all four faces
  fill 0 0 0 to 0 3 0 minecraft:dark_oak_fence
  set 0 4 0 minecraft:lantern[hanging=false,waterlogged=false]
  set 0 3 -1 minecraft:oak_wall_sign[facing=north,waterlogged=false]
  set 1 3 0 minecraft:oak_wall_sign[facing=east,waterlogged=false]
  set 0 3 1 minecraft:oak_wall_sign[facing=south,waterlogged=false]
  set -1 3 0 minecraft:oak_wall_sign[facing=west,waterlogged=false]
  sign_text 0 3 -1 front "" "KEEP" "" ""
  sign_text 1 3 0 front "" "HARBOR" "" ""
  sign_text 0 3 1 front "" "PLAZA" "" ""
  sign_text -1 3 0 front "" "FIELDS" "" ""
}
