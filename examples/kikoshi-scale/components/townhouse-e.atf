component "townhouse-e" {
  bounds -5 0 -6 to 5 18 4
  # plastered inn: rubble stone ground floor, half-timbered plaster upper floor,
  # terracotta gabled roof, posted porch canopy over the door
  fill -4 0 -4 to 4 0 4 minecraft:cobblestone
  fill -4 1 -4 to 4 4 -4 minecraft:cobblestone
  fill -4 1 4 to 4 4 4 minecraft:cobblestone
  fill -4 1 -4 to -4 4 4 minecraft:cobblestone
  fill 4 1 -4 to 4 4 4 minecraft:cobblestone
  # porch canopy on two fence posts
  fill -2 1 -6 to -2 4 -6 minecraft:spruce_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  fill 2 1 -6 to 2 4 -6 minecraft:spruce_fence[east=false,north=false,south=false,waterlogged=false,west=false]
  fill -2 5 -6 to 2 5 -5 minecraft:spruce_slab[type=bottom,waterlogged=false]
  set 0 4 -5 minecraft:lantern[hanging=true,waterlogged=false]
  set 0 1 -4 minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set 0 2 -4 minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  # ground-floor windows: recessed pane + sill
  fill -3 2 -4 to -2 3 -4 minecraft:air
  fill -3 2 -3 to -2 3 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -3 1 -3 to -2 1 -3 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill 2 2 -4 to 3 3 -4 minecraft:air
  fill 2 2 -3 to 3 3 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 1 -3 to 3 1 -3 minecraft:spruce_slab[type=bottom,waterlogged=false]
  fill -4 2 -3 to -4 3 -2 minecraft:air
  fill -3 2 -3 to -3 3 -2 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 4 2 0 to 4 3 1 minecraft:air
  fill 3 2 0 to 3 3 1 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # upper floor: white plaster walls with dark timber corners, studs, top band
  fill -4 6 -4 to 4 9 -4 minecraft:white_terracotta
  fill -4 6 4 to 4 9 4 minecraft:white_terracotta
  fill -4 6 -4 to -4 9 4 minecraft:white_terracotta
  fill 4 6 -4 to 4 9 4 minecraft:white_terracotta
  fill -4 6 -4 to -4 9 -4 minecraft:dark_oak_log
  fill 4 6 -4 to 4 9 -4 minecraft:dark_oak_log
  fill -4 6 4 to -4 9 4 minecraft:dark_oak_log
  fill 4 6 4 to 4 9 4 minecraft:dark_oak_log
  fill 0 6 -4 to 0 9 -4 minecraft:dark_oak_log
  fill 0 6 4 to 0 9 4 minecraft:dark_oak_log
  fill -3 9 -4 to 3 9 -4 minecraft:dark_oak_log
  fill -3 9 4 to 3 9 4 minecraft:dark_oak_log
  # upper windows, front flower boxes
  fill -2 7 -4 to -1 8 -4 minecraft:air
  fill -2 7 -3 to -1 8 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 7 -4 to 2 8 -4 minecraft:air
  fill 1 7 -3 to 2 8 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 6 -5 to -1 6 -5 minecraft:spruce_slab[type=top,waterlogged=false]
  fill 1 6 -5 to 2 6 -5 minecraft:spruce_slab[type=top,waterlogged=false]
  fill -2 7 -5 to -1 7 -5 minecraft:flowering_azalea_leaves[persistent=true,waterlogged=false]
  fill 1 7 -5 to 2 7 -5 minecraft:azalea_leaves[persistent=true,waterlogged=false]
  fill -1 7 4 to 1 8 4 minecraft:air
  fill -1 7 3 to 1 8 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -4 7 -1 to -4 8 1 minecraft:air
  fill -3 7 -1 to -3 8 1 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 4 7 -1 to 4 8 1 minecraft:air
  fill 3 7 -1 to 3 8 1 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # interior: tavern common room, split guest floor, loft
  fill -3 1 -3 to 3 1 3 minecraft:oak_planks
  fill -3 2 -3 to 3 4 3 minecraft:air
  fill -4 5 -4 to 4 5 4 minecraft:oak_planks
  fill -3 6 -3 to 3 8 3 minecraft:air
  fill -3 9 -3 to 3 9 3 minecraft:oak_planks
  fill -3 10 -3 to 3 12 3 minecraft:air
  fill -3 2 2 to -1 2 3 minecraft:oak_planks
  set 2 2 3 minecraft:barrel[facing=up,open=false]
  set 3 2 3 minecraft:barrel[facing=up,open=false]
  set 2 2 -2 minecraft:campfire[facing=north,lit=true,signal_fire=false,waterlogged=false]
  set 0 2 3 minecraft:spruce_stairs[facing=north,half=bottom,waterlogged=false]
  set -2 2 -2 minecraft:spruce_stairs[facing=south,half=bottom,waterlogged=false]
  set 0 2 0 minecraft:red_carpet
  set 0 4 0 minecraft:lantern[hanging=true,waterlogged=false]
  # ladders link the floors (ladder cells pierce the decks)
  fill -3 2 0 to -3 5 0 minecraft:ladder[facing=east,waterlogged=false]
  fill 3 6 -2 to 3 9 -2 minecraft:ladder[facing=west,waterlogged=false]
  # guest floor: partition down the middle, door gap at the south end
  fill 0 6 -3 to 0 8 3 minecraft:spruce_planks
  set 0 6 2 minecraft:spruce_door[facing=west,half=lower,hinge=left,open=false,powered=false]
  set 0 7 2 minecraft:spruce_door[facing=west,half=upper,hinge=left,open=false,powered=false]
  fill -3 6 -2 to -3 7 1 minecraft:bookshelf
  set 2 6 -2 minecraft:red_bed[facing=south,occupied=false,part=foot]
  set 2 6 -1 minecraft:red_bed[facing=south,occupied=false,part=head]
  set -2 8 0 minecraft:lantern[hanging=true,waterlogged=false]
  set 2 8 0 minecraft:lantern[hanging=true,waterlogged=false]
  # loft: bed, stores, lit
  set 2 10 2 minecraft:white_bed[facing=south,occupied=false,part=foot]
  set 2 10 3 minecraft:white_bed[facing=south,occupied=false,part=head]
  set -3 10 3 minecraft:barrel[facing=up,open=false]
  set -3 10 -3 minecraft:barrel[facing=up,open=false]
  set -2 12 0 minecraft:lantern[hanging=true,waterlogged=false]
  set 2 12 0 minecraft:lantern[hanging=true,waterlogged=false]
  # attic walls: plank band under the gable steps
  fill -4 10 -4 to 4 12 -4 minecraft:spruce_planks
  fill -4 10 4 to 4 12 4 minecraft:spruce_planks
  fill -4 10 -4 to -4 12 4 minecraft:spruce_planks
  fill 4 10 -4 to 4 12 4 minecraft:spruce_planks
  # attic gable window
  set 0 11 -4 minecraft:air
  set 0 11 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # gabled roof: terracotta steps, red ridge, plank gable ends
  fill -5 13 -5 to 5 13 5 minecraft:terracotta
  fill -3 14 -5 to 3 14 5 minecraft:terracotta
  fill -1 15 -5 to 1 15 5 minecraft:terracotta
  fill 0 16 -5 to 0 16 5 minecraft:red_terracotta
  fill -4 13 -4 to 4 13 -4 minecraft:spruce_planks
  fill -2 14 -4 to 2 14 -4 minecraft:spruce_planks
  fill 0 15 -4 to 0 15 -4 minecraft:spruce_planks
  fill -4 13 4 to 4 13 4 minecraft:spruce_planks
  fill -2 14 4 to 2 14 4 minecraft:spruce_planks
  fill 0 15 4 to 0 15 4 minecraft:spruce_planks
  fill 3 13 1 to 3 17 1 minecraft:bricks
  set 3 18 1 minecraft:cobblestone_wall[east=false,north=false,south=false,waterlogged=false,west=false]
}
