component "chapel" {
  bounds -6 0 -8 to 6 19 8
  fill -5 0 -7 to 5 0 7 minecraft:stone_bricks
  # nave walls
  fill -4 1 -6 to 4 8 -6 minecraft:stone_bricks
  fill -4 1 6 to 4 8 6 minecraft:stone_bricks
  fill -4 1 -6 to -4 8 6 minecraft:stone_bricks
  fill 4 1 -6 to 4 8 6 minecraft:stone_bricks
  # buttresses flanking the nave
  fill -5 1 -5 to -5 6 -5 minecraft:mossy_stone_bricks
  fill -5 1 -1 to -5 6 -1 minecraft:mossy_stone_bricks
  fill -5 1 3 to -5 6 3 minecraft:mossy_stone_bricks
  fill 5 1 -5 to 5 6 -5 minecraft:mossy_stone_bricks
  fill 5 1 -1 to 5 6 -1 minecraft:mossy_stone_bricks
  fill 5 1 3 to 5 6 3 minecraft:mossy_stone_bricks
  fill -5 7 -5 to -5 7 -5 minecraft:stone_bricks
  fill -5 7 -1 to -5 7 -1 minecraft:stone_bricks
  fill -5 7 3 to -5 7 3 minecraft:stone_bricks
  fill 5 7 -5 to 5 7 -5 minecraft:stone_bricks
  fill 5 7 -1 to 5 7 -1 minecraft:stone_bricks
  fill 5 7 3 to 5 7 3 minecraft:stone_bricks
  # gothic windows with chiseled hoods
  fill -2 3 -6 to -2 6 -6 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 3 -6 to 2 6 -6 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set -2 7 -6 minecraft:chiseled_stone_bricks
  set 2 7 -6 minecraft:chiseled_stone_bricks
  fill -4 3 -3 to -4 6 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 4 3 -3 to 4 6 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set -4 7 3 minecraft:chiseled_stone_bricks
  set 4 7 3 minecraft:chiseled_stone_bricks
  # entrance
  set 0 1 6 minecraft:oak_door[facing=south,half=lower,hinge=left,open=false,powered=false]
  set 0 2 6 minecraft:oak_door[facing=south,half=upper,hinge=left,open=false,powered=false]
  set 0 0 7 minecraft:stone_brick_stairs[facing=south,half=bottom,waterlogged=false]
  # interior: plank floor, two pew rows, altar with candles, lit nave
  fill -3 1 -5 to 3 7 5 minecraft:air
  fill -3 0 -5 to 3 0 5 minecraft:dark_oak_planks
  fill -3 1 -2 to -1 1 2 minecraft:spruce_stairs[facing=north,half=bottom,waterlogged=false]
  fill 1 1 -2 to 3 1 2 minecraft:spruce_stairs[facing=north,half=bottom,waterlogged=false]
  fill -1 1 -5 to 1 1 -5 minecraft:polished_andesite
  set -1 2 -5 minecraft:white_candle[candles=3,lit=true,waterlogged=false]
  set 1 2 -5 minecraft:white_candle[candles=2,lit=true,waterlogged=false]
  set 0 8 0 minecraft:lantern[hanging=true,waterlogged=false]
  # roof ridge along x, overhanging eaves, gable ends
  fill -5 9 -7 to 5 9 7 minecraft:dark_prismarine
  fill -4 10 -5 to 4 10 5 minecraft:dark_prismarine
  fill -3 11 -3 to 3 11 3 minecraft:prismarine_bricks
  fill -1 12 -1 to 1 12 1 minecraft:dark_prismarine
  fill -4 10 -6 to -4 10 -5 minecraft:stone_bricks
  fill -3 11 -4 to -3 11 -3 minecraft:stone_bricks
  fill -1 12 -2 to -1 12 -1 minecraft:stone_bricks
  fill 4 10 -6 to 4 10 -5 minecraft:stone_bricks
  fill 3 11 -4 to 3 11 -3 minecraft:stone_bricks
  fill 1 12 -2 to 1 12 -1 minecraft:stone_bricks
  # bell tower over entrance end
  fill -2 9 4 to 2 15 6 minecraft:stone_bricks
  fill -1 13 4 to 1 14 6 minecraft:air
  fill -1 13 5 to 1 14 5 minecraft:air
  set 0 14 5 minecraft:bell[attachment=floor,facing=north,powered=false]
  fill -2 16 4 to 2 16 6 minecraft:dark_prismarine
  fill -1 17 4 to 1 17 6 minecraft:dark_prismarine
  set 0 18 5 minecraft:lantern[hanging=false,waterlogged=false]
}
