component "ruined-tower" {
  bounds -5 0 -5 to 5 9 5
  # collapsed watchtower stub: broken mossy walls, rubble floor, vines
  fill -4 0 -4 to 4 0 4 minecraft:mossy_cobblestone
  fill -4 1 -4 to 4 6 -4 minecraft:mossy_cobblestone
  fill -4 1 4 to 4 4 4 minecraft:mossy_cobblestone
  fill -4 1 -4 to -4 5 4 minecraft:mossy_cobblestone
  fill 4 1 -4 to 4 3 4 minecraft:mossy_cobblestone
  # intact corner pier vs crumbled side
  fill 3 1 -4 to 4 7 -3 minecraft:cracked_stone_bricks
  fill -4 1 -4 to -3 8 -3 minecraft:cracked_stone_bricks
  # jagged broken rim
  set -2 7 -4 minecraft:mossy_cobblestone
  set 2 6 -4 minecraft:cracked_stone_bricks
  set -4 6 0 minecraft:mossy_cobblestone
  set -4 7 0 minecraft:cracked_stone_bricks
  set 4 4 -1 minecraft:mossy_cobblestone
  set 4 4 3 minecraft:cracked_stone_bricks
  # doorway gap on south face
  fill -1 1 4 to 1 3 4 minecraft:air
  # arrow slit remnants
  fill -4 3 0 to -4 4 0 minecraft:air
  fill 4 2 -2 to 4 3 -2 minecraft:air
  # rubble interior: fallen blocks, chest loot, vines
  fill -3 1 -3 to 3 1 3 minecraft:cobblestone
  set -2 2 -2 minecraft:mossy_cobblestone
  set 1 2 0 minecraft:cracked_stone_bricks
  set 2 2 -2 minecraft:mossy_stone_bricks
  set -1 2 2 minecraft:barrel[facing=up,open=false]
  fill -3 3 -3 to -3 5 -3 minecraft:vine[down=false,east=true,north=false,south=false,up=false,waterlogged=false,west=false]
  set -3 6 -3 minecraft:vine[down=false,east=true,north=false,south=false,up=false,waterlogged=false,west=false]
  fill 1 1 -5 to 2 4 -5 minecraft:vine[down=false,east=false,north=false,south=true,up=false,waterlogged=false,west=false]
}
