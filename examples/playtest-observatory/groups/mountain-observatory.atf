group "mountain observatory" {
  origin -96 0 -96
  bounds 0 0 0 to 192 116 192

  fill 0 0 0 to 192 0 192 minecraft:bedrock
  smooth_terrain 0 0 192 192 from 1 base 58 amplitude 13 scale 36 octaves 4 seed 909 minecraft:grass_block[snowy=false] minecraft:stone
  fill_biome 0 50 0 96 95 192 minecraft:meadow
  fill_biome 97 50 0 192 95 96 minecraft:grove
  fill_biome 97 50 97 192 95 192 minecraft:cherry_grove

  fill 46 1 46 to 146 69 146 minecraft:stone
  fill 50 70 50 to 142 71 142 minecraft:dirt
  fill 54 72 54 to 138 72 138 minecraft:grass_block[snowy=false]
  fill 58 72 58 to 134 72 134 minecraft:stone_bricks
  fill 62 73 62 to 130 73 130 minecraft:polished_andesite
  fill 72 74 72 to 120 74 120 minecraft:smooth_quartz
  hollow_cylinder 96 75 96 32 75 minecraft:deepslate_tiles minecraft:smooth_quartz
  fill 84 75 64 to 108 75 128 minecraft:smooth_quartz
  fill 64 75 84 to 128 75 108 minecraft:smooth_quartz

  place observatory-dome at 81 76 81

  repeat x 68 124 step 14 {
    place path-lamp at $x 76 68
    place path-lamp at $x 76 122
  }
  repeat z 68 124 step 14 {
    place path-lamp at 68 76 $z
    place path-lamp at 122 76 $z
  }

  fill 24 1 36 to 30 66 42 minecraft:stone
  fill 24 67 36 to 30 67 42 minecraft:dirt
  fill 24 68 36 to 30 68 42 minecraft:grass_block[snowy=false]
  place spruce-tree at 24 69 36
  fill 42 1 150 to 48 68 156 minecraft:stone
  fill 42 69 150 to 48 69 156 minecraft:dirt
  fill 42 70 150 to 48 70 156 minecraft:grass_block[snowy=false]
  place spruce-tree at 42 71 150
  fill 146 1 42 to 152 70 48 minecraft:stone
  fill 146 71 42 to 152 71 48 minecraft:dirt
  fill 146 72 42 to 152 72 48 minecraft:grass_block[snowy=false]
  place spruce-tree at 146 73 42
  fill 154 1 146 to 160 71 152 minecraft:stone
  fill 154 72 146 to 160 72 152 minecraft:dirt
  fill 154 73 146 to 160 73 152 minecraft:grass_block[snowy=false]
  place spruce-tree at 154 74 146
  fill 28 1 126 to 34 66 132 minecraft:stone
  fill 28 67 126 to 34 67 132 minecraft:dirt
  fill 28 68 126 to 34 68 132 minecraft:grass_block[snowy=false]
  place spruce-tree at 28 69 126
  fill 130 1 28 to 136 70 34 minecraft:stone
  fill 130 71 28 to 136 71 34 minecraft:dirt
  fill 130 72 28 to 136 72 34 minecraft:grass_block[snowy=false]
  place spruce-tree at 130 73 28

  fill 18 1 84 to 54 68 108 minecraft:stone
  fill 18 69 84 to 54 69 108 minecraft:dirt
  fill 18 70 84 to 54 70 108 minecraft:coarse_dirt
  fill 138 1 84 to 174 71 108 minecraft:stone
  fill 138 72 84 to 174 72 108 minecraft:dirt
  fill 138 73 84 to 174 73 108 minecraft:coarse_dirt
  surface_scatter 18 84 54 108 from 58 to 82 chance 1 2 seed 612 step 3 {
    choose seed 613 {
      weight 2 {
        set 0 0 0 minecraft:allium
      }
      weight 2 {
        set 0 0 0 minecraft:azure_bluet
      }
      weight 1 {
        set 0 0 0 minecraft:short_grass
      }
    }
  }
  surface_scatter 138 84 174 108 from 58 to 84 chance 1 2 seed 712 step 3 {
    choose seed 713 {
      weight 2 {
        set 0 0 0 minecraft:cherry_sapling
      }
      weight 2 {
        set 0 0 0 minecraft:pink_petals
      }
      weight 1 {
        set 0 0 0 minecraft:short_grass
      }
    }
  }

  set 96 76 66 minecraft:oak_wall_sign[facing=south,waterlogged=false]
  sign_text 96 76 66 front "Night Test" "large terrain" "glass dome" ""

  set 100 76 66 minecraft:chest[facing=north,type=single,waterlogged=false]
  block_entity 100 76 66 minecraft:chest {
    string CustomName "Observatory Cache"
    item Items slot 0 minecraft:spyglass count 1
    item Items slot 1 minecraft:clock count 1
    item Items slot 2 minecraft:ender_pearl count 8
  }
}
