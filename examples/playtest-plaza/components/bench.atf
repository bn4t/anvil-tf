  set 0 0 1 minecraft:spruce_trapdoor[facing=north,half=top,open=false,powered=false,waterlogged=false]
  set 1 0 1 minecraft:spruce_trapdoor[facing=north,half=top,open=false,powered=false,waterlogged=false]
  set 2 0 1 minecraft:spruce_trapdoor[facing=north,half=top,open=false,powered=false,waterlogged=false]
  set 3 0 1 minecraft:spruce_trapdoor[facing=north,half=top,open=false,powered=false,waterlogged=false]
  set 4 0 1 minecraft:spruce_trapdoor[facing=north,half=top,open=false,powered=false,waterlogged=false]
}
