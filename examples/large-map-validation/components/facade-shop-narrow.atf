component "facade-shop-narrow" {
  bounds -5 0 -5 to 5 13 5
  fill -4 0 -4 to 4 0 4 minecraft:spruce_planks
  fill -4 1 -4 to 4 6 -4 minecraft:stripped_spruce_wood[axis=y]
  fill -4 1 4 to 4 6 4 minecraft:stripped_spruce_wood[axis=y]
  fill -4 1 -4 to -4 6 4 minecraft:stripped_spruce_wood[axis=y]
  fill 4 1 -4 to 4 6 4 minecraft:stripped_spruce_wood[axis=y]
  fill -3 2 -4 to -1 4 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 2 -4 to 3 4 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -5 5 -5 to 5 5 -5 minecraft:dark_oak_planks
  fill -5 5 -4 to 5 5 -4 minecraft:dark_oak_planks
  set 0 1 -4 minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set 0 2 -4 minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  fill -5 7 -5 to 5 7 5 minecraft:dark_oak_planks
  fill -4 8 -4 to 4 8 4 minecraft:dark_prismarine
  fill -3 9 -3 to 3 9 3 minecraft:prismarine_bricks
  fill -2 10 -2 to 2 10 2 minecraft:dark_prismarine
  fill -1 11 -1 to 1 11 1 minecraft:dark_prismarine
  set 0 12 0 minecraft:sea_lantern
  set 0 13 0 minecraft:lantern[hanging=false,waterlogged=false]
  set -3 1 -5 minecraft:lantern[hanging=false,waterlogged=false]
  set 3 1 -5 minecraft:lantern[hanging=false,waterlogged=false]
}
