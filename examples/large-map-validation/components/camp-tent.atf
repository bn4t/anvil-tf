component "camp-tent" {
  bounds -4 0 -4 to 4 5 4
  fill -4 0 -4 to 4 0 4 minecraft:podzol[snowy=false]
  fill -3 1 -3 to 3 1 3 minecraft:brown_wool
  fill -2 2 -2 to 2 2 2 minecraft:green_wool
  fill -1 3 -1 to 1 4 1 minecraft:green_wool
  set 0 5 0 minecraft:lantern[hanging=false,waterlogged=false]
  set -2 1 0 minecraft:crafting_table
  set 2 1 0 minecraft:barrel[facing=up,open=false]
}
