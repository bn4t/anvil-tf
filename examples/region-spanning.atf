world "Region Spanning Demo" {
  min_y 0
  height 64
  default_biome minecraft:plains
  biome_alias cold = minecraft:snowy_plains

  block marker = minecraft:emerald_block
  block negative_marker = minecraft:lapis_block

  set -513 10 -513 $negative_marker
  set -1 10 -1 minecraft:gold_block
  set 0 10 0 minecraft:diamond_block
  set 512 10 512 $marker

  fill_biome -520 0 -520 -500 32 -500 $cold
  entity 512.5 11 512.5 minecraft:armor_stand {
    byte Marker 1
    byte Invisible 1
  }
}
