component "sail-marker" {
  bounds 0 0 0 to 7 10 1
  fill 0 0 0 to 7 0 1 minecraft:dark_oak_planks
  fill 1 1 0 to 6 1 1 minecraft:dark_oak_slab[type=bottom,waterlogged=false]
  fill 0 0 0 to 0 9 0 minecraft:dark_oak_fence
  fill 1 2 0 to 5 8 0 minecraft:white_wool
  fill 2 3 0 to 6 7 0 minecraft:light_blue_wool
  fill 3 4 0 to 7 6 0 minecraft:white_wool
  set 0 10 0 minecraft:lantern[hanging=false,waterlogged=false]
}
