component "market-awning" {
  bounds 0 0 0 to 8 5 6
  fill 0 0 0 to 8 0 6 minecraft:spruce_planks
  fill 0 1 0 to 0 4 0 minecraft:spruce_fence
  fill 8 1 0 to 8 4 0 minecraft:spruce_fence
  fill 0 1 6 to 0 4 6 minecraft:spruce_fence
  fill 8 1 6 to 8 4 6 minecraft:spruce_fence
  fill 0 5 0 to 8 5 6 minecraft:blue_wool
  fill 2 5 0 to 2 5 6 minecraft:white_wool
  fill 5 5 0 to 5 5 6 minecraft:white_wool
  set 2 1 3 minecraft:barrel[facing=north,open=false]
  set 6 1 3 minecraft:crafting_table
}
