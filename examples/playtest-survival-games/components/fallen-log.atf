component "fallen-log" {
  bounds 0 0 0 to 10 3 4
  fill 1 0 2 to 9 0 2 minecraft:oak_log[axis=x]
  set 0 0 2 minecraft:oak_leaves[persistent=true,distance=1]
  set 10 0 2 minecraft:oak_leaves[persistent=true,distance=1]
  set 3 1 1 minecraft:red_mushroom
  set 6 1 3 minecraft:brown_mushroom
  set 8 1 1 minecraft:vine[north=true,east=false,south=false,west=false,up=false]
}
