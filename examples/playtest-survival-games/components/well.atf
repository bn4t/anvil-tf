component "well" {
  bounds 0 0 0 to 6 6 6
  fill 1 0 1 to 5 0 5 minecraft:cobblestone
  set 3 1 3 minecraft:water[level=0]
  fill 1 1 1 to 1 3 1 minecraft:cobblestone_wall
  fill 5 1 1 to 5 3 1 minecraft:cobblestone_wall
  fill 1 1 5 to 1 3 5 minecraft:cobblestone_wall
  fill 5 1 5 to 5 3 5 minecraft:cobblestone_wall
  fill 0 4 0 to 6 4 6 minecraft:dark_oak_planks
  fill 1 5 1 to 5 5 5 minecraft:dark_oak_slab[type=bottom,waterlogged=false]
  set 3 3 3 minecraft:chain[axis=y,waterlogged=false]
  set 3 2 3 minecraft:water_cauldron[level=2]
}
