component "ruined-arch" {
  bounds 0 0 0 to 10 8 2
  fill 0 0 0 to 1 5 1 minecraft:stone_bricks
  fill 8 0 0 to 9 4 1 minecraft:mossy_stone_bricks
  fill 2 5 0 to 7 6 1 minecraft:cracked_stone_bricks
  set 4 7 0 minecraft:chiseled_stone_bricks
  set 5 7 1 minecraft:stone_brick_slab[type=bottom,waterlogged=false]
  set 2 0 2 minecraft:mossy_cobblestone
  set 7 0 2 minecraft:cobblestone
}
