component "campfire-ring" {
  bounds 0 0 0 to 8 3 8
  fill 1 0 1 to 7 0 7 minecraft:coarse_dirt
  set 3 1 2 minecraft:cobblestone
  set 4 1 2 minecraft:cobblestone
  set 5 1 2 minecraft:cobblestone
  set 2 1 3 minecraft:cobblestone
  set 6 1 3 minecraft:cobblestone
  set 2 1 4 minecraft:cobblestone
  set 6 1 4 minecraft:cobblestone
  set 2 1 5 minecraft:cobblestone
  set 6 1 5 minecraft:cobblestone
  set 3 1 6 minecraft:cobblestone
  set 4 1 6 minecraft:cobblestone
  set 5 1 6 minecraft:cobblestone
  set 4 1 4 minecraft:campfire[facing=north,lit=true,signal_fire=false,waterlogged=false]
  fill 0 1 4 to 1 1 4 minecraft:oak_log[axis=x]
  fill 7 1 4 to 8 1 4 minecraft:oak_log[axis=x]
  fill 4 1 0 to 4 1 1 minecraft:oak_log[axis=z]
  fill 4 1 7 to 4 1 8 minecraft:oak_log[axis=z]
}
