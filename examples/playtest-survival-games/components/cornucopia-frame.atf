component "cornucopia-frame" {
  bounds 0 0 0 to 28 10 28
  fill 2 0 2 to 26 0 26 minecraft:polished_deepslate
  hollow_cylinder 14 1 14 12 1 minecraft:chiseled_stone_bricks minecraft:smooth_stone
