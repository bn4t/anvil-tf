component "watchtower" {
  bounds 0 0 0 to 8 14 8
  fill 1 0 1 to 1 10 1 minecraft:dark_oak_fence
  fill 7 0 1 to 7 10 1 minecraft:dark_oak_fence
  fill 1 0 7 to 1 10 7 minecraft:dark_oak_fence
  fill 7 0 7 to 7 10 7 minecraft:dark_oak_fence
  fill 0 8 0 to 8 8 8 minecraft:spruce_planks
  fill 0 9 0 to 8 9 0 minecraft:spruce_fence
  fill 0 9 8 to 8 9 8 minecraft:spruce_fence
  fill 0 9 0 to 0 9 8 minecraft:spruce_fence
  fill 8 9 0 to 8 9 8 minecraft:spruce_fence
  fill 0 11 0 to 8 11 8 minecraft:dark_oak_planks
  fill 1 12 1 to 7 12 7 minecraft:dark_oak_slab[type=bottom,waterlogged=false]
  fill 4 0 0 to 4 8 0 minecraft:stripped_dark_oak_log[axis=y]
  fill 4 0 1 to 4 8 1 minecraft:ladder[facing=south,waterlogged=false]
  set 4 10 4 minecraft:lantern[hanging=true,waterlogged=false]
}
