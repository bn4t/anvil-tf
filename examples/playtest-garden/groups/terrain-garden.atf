group "terrain garden" {
  origin -48 0 -48
  bounds 0 0 0 to 95 32 95

  fill 0 0 0 to 95 0 95 minecraft:bedrock
  smooth_terrain 0 0 95 95 from 1 base 10 amplitude 5 scale 22 octaves 3 seed 320 minecraft:grass_block[snowy=false] minecraft:dirt
  fill_biome 0 4 0 47 32 95 minecraft:meadow
  fill_biome 48 4 0 95 32 47 minecraft:cherry_grove
  fill_biome 48 4 48 95 32 95 minecraft:flower_forest

  fill 45 18 45 to 51 18 51 minecraft:oak_planks
  fill 46 19 46 to 50 19 50 minecraft:yellow_carpet
  set 48 19 48 minecraft:gold_block
  set 48 20 44 minecraft:oak_wall_sign[facing=south,waterlogged=false]
  sign_text 48 20 44 front "Spawn" "platform" "over terrain" ""

  hollow_cylinder 48 11 48 8 12 minecraft:mossy_cobblestone minecraft:air
  cylinder 48 11 48 6 11 minecraft:water[level=0]
  line 36 13 48 40 13 48 minecraft:oak_slab[type=top,waterlogged=false]
  line 56 13 48 60 13 48 minecraft:oak_slab[type=top,waterlogged=false]
  line 48 13 36 48 13 40 minecraft:oak_slab[type=top,waterlogged=false]
  line 48 13 56 48 13 60 minecraft:oak_slab[type=top,waterlogged=false]

  place tree-marker at 18 12 18
  place tree-marker at 74 12 18
  place tree-marker at 18 12 74
  place tree-marker at 74 12 74

  surface_scatter 4 4 91 91 from 1 to 20 chance 1 5 seed 77 step 4 {
    choose seed 79 {
      weight 4 {
        set 0 0 0 minecraft:poppy
      }
      weight 3 {
        set 0 0 0 minecraft:dandelion
      }
      weight 2 {
        set 0 0 0 minecraft:short_grass
      }
      weight 1 {
        set 0 0 0 minecraft:mossy_cobblestone
      }
    }
  }
}
