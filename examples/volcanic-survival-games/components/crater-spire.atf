# Obsidian spike that rings the cornucopia rim. Iron-bar collar for a jagged
# silhouette, crying-obsidian shoulder, glowstone tip.
component "crater-spire" {
  bounds 0 0 0 to 2 8 2
  fill 1 0 1 to 1 6 1 minecraft:obsidian
  set 1 3 0 minecraft:iron_bars
  set 1 3 2 minecraft:iron_bars
  set 0 3 1 minecraft:iron_bars
  set 2 3 1 minecraft:iron_bars
  set 1 7 1 minecraft:crying_obsidian
  set 1 8 1 minecraft:glowstone
}
