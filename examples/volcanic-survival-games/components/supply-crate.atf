# Ash-dusted pallet of barrels and a cartography table. Decoration only; the
# low-tier loot chest is placed next to it in the arena group.
component "supply-crate" {
  bounds 0 0 0 to 3 2 3
  fill 0 0 0 to 3 0 3 minecraft:basalt
  set 0 0 0 minecraft:gray_concrete_powder
  set 3 0 3 minecraft:gray_concrete_powder
  set 1 1 1 minecraft:barrel[facing=up,open=false]
  set 2 1 1 minecraft:barrel[facing=up,open=false]
  set 1 1 2 minecraft:cartography_table
  set 3 1 3 minecraft:cobweb
}
