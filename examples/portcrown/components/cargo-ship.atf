component "cargo-ship" {
  bounds -13 0 -5 to 12 21 5
  # hull: tapered two-deck hull, bow points -x
  fill -10 0 -2 to 10 0 2 minecraft:dark_oak_planks
  fill -11 1 -3 to 11 1 3 minecraft:dark_oak_planks
  fill -10 2 -4 to 10 2 4 minecraft:dark_oak_planks
  fill -9 3 -4 to 9 3 4 minecraft:dark_oak_planks
  fill -8 4 -5 to 8 4 5 minecraft:spruce_planks
  # deck
  fill -9 4 -3 to 9 4 3 minecraft:spruce_planks
  # bulwark rails
  fill -9 5 -4 to 9 5 -4 minecraft:dark_oak_planks
  fill -9 5 4 to 9 5 4 minecraft:dark_oak_planks
  fill -9 5 -4 to -9 5 4 minecraft:dark_oak_planks
  fill 9 5 -4 to 9 5 4 minecraft:dark_oak_planks
  # stern castle step-up
  fill 6 5 -3 to 9 7 3 minecraft:dark_oak_planks
  fill 6 5 -3 to 9 5 3 minecraft:dark_oak_planks
  # two masts
  fill -4 5 0 to -4 16 0 minecraft:spruce_log
  fill 4 5 0 to 4 14 0 minecraft:spruce_log
  # square sails (white wool, wind-filled box feel)
  fill -7 9 -1 to -1 15 1 minecraft:white_wool
  fill -7 15 -1 to -1 15 1 minecraft:oak_planks
  fill 1 8 -1 to 7 13 1 minecraft:white_wool
  fill 1 13 -1 to 7 13 1 minecraft:oak_planks
  # rigging hint: yard ropes
  fill -4 16 -1 to -4 16 1 minecraft:iron_chain
  fill 4 15 -1 to 4 15 1 minecraft:iron_chain
  # prow: extended keel, stepped bow wall, flag on the stem post
  fill -13 0 -1 to -11 0 1 minecraft:dark_oak_planks
  fill -12 1 -1 to -12 4 1 minecraft:dark_oak_planks
  fill -13 1 0 to -13 5 0 minecraft:spruce_log
  set -13 6 0 minecraft:red_wool
  set 9 8 0 minecraft:lantern[hanging=false,waterlogged=false]
}
