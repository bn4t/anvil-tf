component "townhouse-a" {
  bounds -6 0 -5 to 6 15 5
  # stone foundation + ground floor
  fill -6 0 -5 to 6 0 5 minecraft:stone_bricks
  fill -6 1 -5 to 6 4 -5 minecraft:cobblestone
  fill -6 1 5 to 6 4 5 minecraft:cobblestone
  fill -6 1 -5 to -6 4 5 minecraft:cobblestone
  fill 6 1 -5 to 6 4 5 minecraft:cobblestone
  # timber-frame upper floor
  fill -6 5 -5 to 6 9 -5 minecraft:white_wool
  fill -6 5 5 to 6 9 5 minecraft:white_wool
  fill -6 5 -5 to -6 9 5 minecraft:white_wool
  fill 6 5 -5 to 6 9 5 minecraft:white_wool
  # frame posts + beams
  fill -6 5 -5 to -6 9 -5 minecraft:dark_oak_log
  fill 6 5 -5 to 6 9 -5 minecraft:dark_oak_log
  fill -6 5 5 to -6 9 5 minecraft:dark_oak_log
  fill 6 5 5 to 6 9 5 minecraft:dark_oak_log
  fill -6 5 -5 to 6 5 -5 minecraft:dark_oak_log
  fill -6 5 5 to 6 5 5 minecraft:dark_oak_log
  fill -6 9 -5 to 6 9 -5 minecraft:dark_oak_log
  fill -6 9 5 to 6 9 5 minecraft:dark_oak_log
  # windows + door
  fill -4 2 -5 to -2 3 -5 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 2 -5 to 4 3 -5 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -4 6 -5 to -2 8 -5 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 6 -5 to 4 8 -5 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -4 6 5 to -2 8 5 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 2 6 5 to 4 8 5 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 1 -5 minecraft:oak_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set 0 2 -5 minecraft:oak_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  # pitched roof (stepped layers) + chimney
  fill -7 10 -6 to 7 10 6 minecraft:dark_prismarine
  fill -5 11 -4 to 5 11 4 minecraft:dark_prismarine
  fill -4 12 -3 to 4 12 3 minecraft:prismarine_bricks
  fill -2 13 -2 to 2 13 2 minecraft:dark_prismarine
  fill -1 14 -1 to 1 14 1 minecraft:mossy_stone_bricks
  fill 4 11 1 to 4 14 1 minecraft:cobblestone
  set 4 15 1 minecraft:cobblestone_wall[east=false,north=false,south=false,waterlogged=false,west=false]
  set 0 10 -6 minecraft:lantern[hanging=false,waterlogged=false]
}
