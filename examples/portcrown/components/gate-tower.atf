component "gate-tower" {
  bounds -3 0 -3 to 3 15 3
  fill -3 0 -3 to 3 0 3 minecraft:stone_bricks
  # tower walls, hollow
  fill -3 1 -3 to 3 12 -3 minecraft:stone_bricks
  fill -3 1 3 to 3 12 3 minecraft:stone_bricks
  fill -3 1 -3 to -3 12 3 minecraft:stone_bricks
  fill 3 1 -3 to 3 12 3 minecraft:stone_bricks
  fill -2 1 -2 to 2 12 2 minecraft:air
  # arrow slits
  set 0 5 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 9 -3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 5 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 9 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # crenellated top
  fill -3 13 -3 to 3 13 3 minecraft:mossy_stone_bricks
  fill -3 14 -3 to -3 14 3 minecraft:stone_bricks
  fill 3 14 -3 to 3 14 3 minecraft:stone_bricks
  set -1 14 -3 minecraft:stone_bricks
  set 1 14 -3 minecraft:stone_bricks
  set -1 14 3 minecraft:stone_bricks
  set 1 14 3 minecraft:stone_bricks
  set 0 15 0 minecraft:sea_lantern
}
