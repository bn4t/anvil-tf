component "windmill" {
  bounds -3 0 -3 to 6 17 3
  # tapering tower
  fill -3 0 -3 to 3 4 3 minecraft:cobblestone
  fill -2 5 -2 to 2 10 2 minecraft:spruce_planks
  fill -1 11 -1 to 1 14 1 minecraft:spruce_planks
  # windows
  set 0 7 -2 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 12 -1 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 1 -3 minecraft:oak_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set 0 2 -3 minecraft:oak_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  # cap
  fill -2 15 -2 to 2 15 2 minecraft:dark_prismarine
  fill -1 16 -1 to 1 16 1 minecraft:dark_prismarine
  # sails: hub on north face, four wool arms
  fill -1 12 -2 to -1 12 -3 minecraft:spruce_log
  fill -4 9 -3 to 2 15 -3 minecraft:white_wool
  fill 2 9 -3 to 2 12 -3 minecraft:air
  fill -4 12 -3 to -4 15 -3 minecraft:air
  fill -3 13 -3 to -3 16 -3 minecraft:oak_planks
  fill 0 8 -3 to 0 11 -3 minecraft:oak_planks
}
