component "lighthouse" {
  bounds -4 0 -4 to 4 27 4
  # striped shaft
  fill -3 0 -3 to 3 5 3 minecraft:white_wool
  fill -3 6 -3 to 3 10 3 minecraft:red_wool
  fill -3 11 -3 to 3 15 3 minecraft:white_wool
  fill -3 16 -3 to 3 20 3 minecraft:red_wool
  fill -3 21 -3 to 3 24 3 minecraft:white_wool
  # hollow core
  fill -2 1 -2 to 2 24 2 minecraft:air
  # entrance + slit windows
  set 0 1 -3 minecraft:air
  set 0 2 -3 minecraft:air
  set -3 8 0 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 3 14 0 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 19 3 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  # gallery ring
  fill -4 25 -4 to 4 25 4 minecraft:dark_prismarine
  fill -4 26 -4 to -4 26 4 minecraft:dark_prismarine
  fill 4 26 -4 to 4 26 4 minecraft:dark_prismarine
  fill -4 26 -4 to 4 26 -4 minecraft:dark_prismarine
  fill -4 26 4 to 4 26 4 minecraft:dark_prismarine
  # lantern room
  set 0 26 0 minecraft:sea_lantern
  fill -1 26 -1 to 1 26 1 minecraft:glass_pane[east=true,north=true,south=true,waterlogged=false,west=true]
  fill -2 26 -2 to -2 26 2 minecraft:glass_pane[east=true,north=true,south=true,waterlogged=false,west=true]
  fill 2 26 -2 to 2 26 2 minecraft:glass_pane[east=true,north=true,south=true,waterlogged=false,west=true]
  fill -2 27 -2 to 2 27 2 minecraft:dark_prismarine
}
