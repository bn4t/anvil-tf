component "town-wall" {
  bounds -5 0 -1 to 5 8 1
  fill -5 0 -1 to 5 5 1 minecraft:stone_bricks
  # parapet walk + crenellations
  fill -5 6 -1 to 5 6 -1 minecraft:mossy_stone_bricks
  fill -5 6 1 to 5 6 1 minecraft:mossy_stone_bricks
  set -4 7 -1 minecraft:stone_bricks
  set -2 7 -1 minecraft:stone_bricks
  set 0 7 -1 minecraft:stone_bricks
  set 2 7 -1 minecraft:stone_bricks
  set 4 7 -1 minecraft:stone_bricks
  set -4 7 1 minecraft:stone_bricks
  set -2 7 1 minecraft:stone_bricks
  set 0 7 1 minecraft:stone_bricks
  set 2 7 1 minecraft:stone_bricks
  set 4 7 1 minecraft:stone_bricks
}
