component "fountain" {
  bounds -4 0 -4 to 4 5 4
  # basin ring
  fill -4 0 -4 to 4 0 4 minecraft:stone_bricks
  fill -4 1 -4 to 4 1 -4 minecraft:mossy_stone_bricks
  fill -4 1 4 to 4 1 4 minecraft:mossy_stone_bricks
  fill -4 1 -4 to -4 1 4 minecraft:mossy_stone_bricks
  fill 4 1 -4 to 4 1 4 minecraft:mossy_stone_bricks
  # water basin
  fill -3 1 -3 to 3 1 3 minecraft:water[level=0]
  # center column + spout
  fill 0 1 0 to 0 3 0 minecraft:stone_bricks
  set 0 4 0 minecraft:sea_lantern
  set 0 2 0 minecraft:water[level=0]
}
