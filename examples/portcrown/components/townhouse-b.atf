component "townhouse-b" {
  bounds -4 0 -4 to 4 17 4
  fill -4 0 -4 to 4 0 4 minecraft:stone_bricks
  # narrow three-story town house, stone skin
  fill -4 1 -4 to 4 5 -4 minecraft:mossy_stone_bricks
  fill -4 1 4 to 4 5 4 minecraft:mossy_stone_bricks
  fill -4 1 -4 to -4 5 4 minecraft:mossy_stone_bricks
  fill 4 1 -4 to 4 5 4 minecraft:mossy_stone_bricks
  fill -4 6 -4 to 4 9 -4 minecraft:spruce_planks
  fill -4 6 4 to 4 9 4 minecraft:spruce_planks
  fill -4 6 -4 to -4 9 4 minecraft:spruce_planks
  fill 4 6 -4 to 4 9 4 minecraft:spruce_planks
  fill -4 10 -4 to 4 13 -4 minecraft:mossy_stone_bricks
  fill -4 10 4 to 4 13 4 minecraft:mossy_stone_bricks
  fill -4 10 -4 to -4 13 4 minecraft:mossy_stone_bricks
  fill 4 10 -4 to 4 13 4 minecraft:mossy_stone_bricks
  # floor slabs between stories
  fill -4 5 -4 to 4 5 4 minecraft:dark_oak_planks
  fill -4 9 -4 to 4 9 4 minecraft:dark_oak_planks
  # windows
  fill -2 3 -4 to 0 4 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 3 -4 to 3 4 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 7 -4 to 0 8 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 7 -4 to 3 8 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 11 -4 to 0 12 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 11 -4 to 3 12 -4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill -2 11 4 to 0 12 4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  fill 1 11 4 to 3 12 4 minecraft:glass_pane[east=true,north=false,south=false,waterlogged=false,west=true]
  set 0 1 -4 minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false,powered=false]
  set 0 2 -4 minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false,powered=false]
  # steep roof
  fill -5 14 -5 to 5 14 5 minecraft:dark_prismarine
  fill -4 15 -4 to 4 15 4 minecraft:dark_prismarine
  fill -2 16 -2 to 2 16 2 minecraft:prismarine_bricks
  set 0 17 0 minecraft:lantern[hanging=false,waterlogged=false]
}
