world "Terrain Garden Demo" {
  min_y 0
  height 96
  spawn 0 14 0
  default_biome minecraft:meadow

  block flower = minecraft:poppy
  block stone = minecraft:mossy_cobblestone

  smooth_terrain -48 -48 47 47 from 1 base 8 amplitude 5 scale 18 octaves 3 seed 101 minecraft:grass_block[snowy=false] minecraft:dirt
  fill -48 0 -48 47 0 47 minecraft:bedrock
  fill_biome -48 8 -48 47 24 47 minecraft:meadow

  surface_scatter -44 -44 44 44 from 1 to 18 chance 1 7 seed 55 step 4 {
    choose seed 57 {
      weight 4 {
        set 0 0 0 $flower
      }
      weight 2 {
        set 0 0 0 minecraft:grass
      }
      weight 1 {
        set 0 0 0 $stone
      }
    }
  }

  hollow_cylinder 0 9 0 7 11 minecraft:stone_bricks minecraft:air
  cylinder 0 9 0 5 9 minecraft:water[level=0]
  line -10 10 0 -7 10 0 minecraft:oak_slab[type=top,waterlogged=false]
  line 7 10 0 10 10 0 minecraft:oak_slab[type=top,waterlogged=false]
  line 0 10 -10 0 10 -7 minecraft:oak_slab[type=top,waterlogged=false]
  line 0 10 7 0 10 10 minecraft:oak_slab[type=top,waterlogged=false]
}
